{
  "name": "smart-maktab",
  "version": "1.0.0",
  "description": "Smart Maktab OS Cloud Edition",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.smartmaktab.desktop",
    "productName": "Smart Maktab OS",
    "directories": {
      "output": "dist-build"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "server.js",
      "electron-main.js",
      "electron-preload.js",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "express": "^5.2.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.2"
  }
}
